# 인터넷과 서비스 사이의 유일한 통로.
#
# 도메인 이름만 적으면 Caddy가 Let's Encrypt에서 인증서를 받아오고 만료 전에 스스로
# 갱신한다. HTTP로 들어온 요청은 HTTPS로 돌린다. 이 파일에 인증서 경로나 갱신 주기가
# 없는 것은 빠뜨린 것이 아니라 Caddy가 하는 일이기 때문이다.
#
# TLS가 여기서 끝나면 안 되고 브라우저부터 여기까지 끊기지 않아야 한다. 방문자의
# OpenAI 키가 헤더로 오기 때문이다(ADR-024 §24-R, ADR-031 §31.5). Cloudflare DNS에서
# 이 도메인의 A 레코드는 반드시 회색 구름(DNS only)이어야 한다 — 주황색이면
# Cloudflare가 TLS를 종료하고 여기까지는 평문이 된다.

# 두 호스트가 같은 보안 헤더를 쓴다. 청중과 위협이 같으므로 값이 갈릴 이유가 없고,
# 한쪽만 고쳐 어긋나는 것을 막으려면 값을 한 곳에만 둬야 한다(SPEC.yaml portfolio host).
(security_headers) {
	# .dev는 브라우저가 HSTS를 강제하는 TLD지만, 헤더로도 명시한다. TLD의 성질에
	# 기대는 것과 서버가 선언하는 것은 다르고, 다른 TLD로 옮겨도 보장이 남는다.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

loan.gwang.dev {
	# 화면만 외부에 노출한다. API(app)는 컨테이너 내부망에만 둔다 — Streamlit이
	# 서버 사이드에서 app을 부르므로 브라우저가 직접 닿을 이유가 없다. 리스크 대장
	# B3가 "실서비스라면 진입점을 리버스 프록시 하나로 모으고 app도 내부에만 둔다"고
	# 적어 둔 것이 여기서 실현된다.
	#
	# Streamlit은 웹소켓으로 화면을 갱신한다. Caddy의 reverse_proxy가 업그레이드를
	# 그대로 넘기므로 따로 설정하지 않는다.
	reverse_proxy ui:8501

	import security_headers

	# 접근 로그에서 방문자 키를 지운다. Caddy의 JSON 로그는 요청 헤더를 기록하고
	# 기본 마스킹 대상은 Authorization과 Cookie뿐이라, 직접 만든 헤더는 그대로
	# 남는다. 지우지 않으면 "키는 세션 메모리에만 둔다"는 통제가 로그에서 무너지고
	# 금지 자동화 행위 ⑦(키 로깅)을 어긴다.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Openai-Api-Key delete
			}
		}
	}
}

# 포트폴리오 호스트. 지원서가 링크 하나만 받으므로 이 페이지가 제출물 본체다
# (SPEC.yaml portfolio host, ADR-031 개정 2026-09-01).
#
# `ui`를 거치지 않고 Caddy가 파일을 직접 낸다. 프록시로 두면 Streamlit이 죽을 때
# 포트폴리오가 함께 사라지는데, 그 실패 양상은 가정이 아니라 `#61`에서 실측됐다.
gwang.dev {
	import security_headers

	# 공개 표면은 요청이 아니라 이 디렉터리다. `root`는 여기 있는 것을 전부 내보내므로
	# 두 가지가 구속이다 — 리스팅을 켜지 않는다(`browse`를 절대 추가하지 않는다),
	# 그리고 공개할 파일만 넣는다. 저장소 작업 트리를 가리키면 `.env`가 함께 나간다.
	root * /srv/site
	file_server

	encode gzip zstd

	# 방문자 키가 이 호스트로 오지 않으므로 서비스 호스트의 로그 키 필터가 여기엔
	# 없다. 빠뜨린 것이 아니라 범위의 사실이다.
	log {
		output stdout
	}
}
