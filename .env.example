# 이 파일을 복사해 `.env` 로 저장한 뒤 실제 값을 채운다.
#
#   cp .env.example .env
#
# `.env` 는 .gitignore 대상이라 커밋되지 않는다.

# ── PostgreSQL (필수) ────────────────────────────────────────────────
# Compose가 이 값을 요구한다. 비어 있으면 `Set POSTGRES_USER` 로 기동이 멈춘다.
# 비밀번호는 직접 짓지 말고 만들어 쓴다:  openssl rand -base64 24
POSTGRES_USER=loan
POSTGRES_PASSWORD=여기에_긴_임의_문자열
POSTGRES_DB=loan_suitability

# ── LLM (선택) ──────────────────────────────────────────────────────
# 없어도 결정적 심사·규칙 파서·무토큰 데모·전체 테스트가 동작한다.
# 안내문 생성과 LLM 파서에만 필요하다.
#
# 운영 배포에는 이 키를 두지 않는다(ADR-031 §31.3). 방문자가 화면에서 자기 키를
# 입력하고, 그 키는 세션 메모리에만 머물며 저장·로깅되지 않는다.
OPENAI_API_KEY=sk-여기에_본인_키
OPENAI_MODEL_NAME=openai/gpt-4o-mini
