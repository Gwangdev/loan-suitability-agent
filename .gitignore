# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── 가상환경 ───────────────────────────────────────────
.venv/
venv/
env/

# ── 비밀/환경 (커밋 금지) ──────────────────────────────
.env
.streamlit/secrets.toml

# ── OS / 에디터 ────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── 대용량 산출물 (로컬 보관, git 미포함) ───────────────
#   발표자료 원본(.pptx)은 용량이 커 저장소에 넣지 않는다.
#   공유가 필요하면 PDF로 export 해 docs/ 에 별도 관리 권장.
*.pptx
.claude/settings.local.json

# ── 로컬 보관 (git 미포함) ─────────────────────────────
#   교체된 이전 버전 산출물을 로컬에만 남긴다.
archive/

# ── 작업 기록 (git 미포함) ─────────────────────────────
#   하네스의 상태 파일·피드백 대장·LLM 인계 프롬프트는 판단의 근거로만 쓰고 공개하지 않는다.
#   결과는 설계결정·리스크 통제 대장·평가리포트 같은 정리된 문서와 코드·테스트·커밋 이력으로
#   보여 준다. 그 밖의 개인 작업 문서는 파일명도 드러나지 않도록 저장소에 올라가지 않는 로컬
#   설정(.git/info/exclude)에서 제외한다.
PROJECT_STATE.md
PROJECT_LOG.md
INSIGHTS.md
prompts/
